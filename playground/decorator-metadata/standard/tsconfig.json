{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Decorators"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "strict": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "rootDir": "src",
    "outDir": "out"
  },
  "include": ["src"]
}
